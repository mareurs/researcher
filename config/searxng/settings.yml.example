# Minimal SearXNG config for Researcher
# Enables JSON output format and disables the web UI rate limiter.
#
# TEMPLATE — copy to settings.yml before starting the infra stack:
#   make searxng-config      (or: cp settings.yml.example settings.yml)
#
# settings.yml is gitignored because it carries a live Brave api_key.
# Put real secrets ONLY in settings.yml — never in this template.

use_default_settings:
  engines:
    keep_only:
      - google
      - duckduckgo
      - bing
      - wikipedia

general:
  instance_name: "Researcher SearXNG"
  debug: false

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "en"
  formats:
    - html
    - json   # Required — researcher uses the JSON API

server:
  secret_key: "researcher-local-secret-change-in-prod"
  limiter: false   # Disable rate limiting for local use
  image_proxy: false

outgoing:
  # Tor proxy for web-scraping engines (Google, DDG, Bing)
  # Prevents IP-based rate limits and CAPTCHAs
  proxies:
    all://:
      - socks5h://tor:9050
  using_tor_proxy: true

engines:
  - name: google
    engine: google
    shortcut: g
    # Blocked via Tor AND direct (403 / access-denied) — pure error noise.
    # braveapi covers this result class reliably.
    disabled: true
  - name: duckduckgo
    engine: duckduckgo
    shortcut: ddg
    disabled: false
    # DDG blocks Tor exit nodes (HTTP 403); route this engine direct instead of
    # via the global outgoing.proxies Tor proxy.
    network:
      using_tor_proxy: false
      proxies: {}
  - name: bing
    engine: bing
    shortcut: bi
    disabled: false
  # Brave Search API — no rate limits, no CAPTCHAs
  - name: braveapi
    engine: braveapi
    shortcut: brapi
    # Set your real key in settings.yml (gitignored), NOT in this template.
    api_key: REPLACE_WITH_BRAVE_API_KEY
    disabled: false
  - name: wikipedia
    engine: wikipedia
    shortcut: wp
    disabled: false

ui:
  default_theme: simple
  query_in_title: false
